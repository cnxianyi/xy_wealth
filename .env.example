XY_WEALTH_APP_ENVIRONMENT=development
XY_WEALTH_HTTP_ADDRESS=:8080
XY_WEALTH_LOG_LEVEL=info
XY_WEALTH_LOG_ENCODING=json

XY_WEALTH_POSTGRES_DSN=postgres://xy_wealth:xy_wealth@localhost:5432/xy_wealth?sslmode=disable
XY_WEALTH_REDIS_ADDRESS=localhost:6379
XY_WEALTH_REDIS_PASSWORD=
XY_WEALTH_REDIS_DB=0

# Create a read-only Binance key. Never grant withdrawal permission.
XY_WEALTH_BINANCE_BASE_URL=https://api.binance.com
XY_WEALTH_BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
XY_WEALTH_BINANCE_COIN_M_FUTURES_BASE_URL=https://dapi.binance.com
XY_WEALTH_BINANCE_API_KEY=
XY_WEALTH_BINANCE_SECRET_KEY=
XY_WEALTH_BINANCE_RECV_WINDOW=5000
XY_WEALTH_BINANCE_INCLUDE_ZERO=false

XY_WEALTH_WEEX_SPOT_BASE_URL=https://api-spot.weex.com
XY_WEALTH_WEEX_CONTRACT_BASE_URL=https://api-contract.weex.com
XY_WEALTH_WEEX_API_KEY=
XY_WEALTH_WEEX_SECRET_KEY=
XY_WEALTH_WEEX_PASSPHRASE=
XY_WEALTH_WEEX_INCLUDE_ZERO=false
